#!/bin/sh
# Auto-runs scripts/precommit.py before every commit, if docs/, TERMINOLOGY.md
# or CONTENT_MAP.md changed. Installed via:
#   git config core.hooksPath .githooks
# (one-time per clone — see README.md "Szkriptek" section).
#
# This exists so the checks aren't just "remembered" — a forgotten
# check_terminology.py run is exactly how terminology drift slips into a
# commit unnoticed.

changed=$(git diff --cached --name-only)
if ! echo "$changed" | grep -qE '^(docs/|TERMINOLOGY\.md|CONTENT_MAP\.md)'; then
  exit 0
fi

echo "docs/ vagy terminológiai fájl változott — precommit.py futtatása..."
python scripts/precommit.py
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "A commit megállt. Javítsd a jelzett problémát (vagy ha a CONTENT_MAP.md"
  echo "automatikusan módosult, git add CONTENT_MAP.md), majd commitolj újra."
fi

exit $status

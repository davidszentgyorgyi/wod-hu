# Ez a fájl mutatja, milyen környezeti változókra lehet szükség.
# Másold .env néven, és töltsd ki valódi értékekkel — a .env fájlt a .gitignore blokkolja, SOHA nem kerül fel a repóba.

# Google Search Console / Analytics (opcionális, ha később bekötjük)
# GA_MEASUREMENT_ID=

# Netlify build hook (ha automata tartalom-szinkronhoz kell)
# NETLIFY_BUILD_HOOK_URL=
